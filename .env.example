SECRET_KEY=
ADMIN_USERNAME=
# bcrypt-хэш пароля. ВАЖНО: этот файл читает Docker Compose, который интерполирует "$" как
# переменные — каждый "$" в хэше нужно удвоить ("$" -> "$$"), иначе значение обрежется.
ADMIN_PASSWORD_HASH=
DATABASE_URL=sqlite:///./data/filament.db
# COOKIE_SECURE=false  # раскомментировать для локальной разработки без HTTPS; в проде должен быть true (по умолчанию)
